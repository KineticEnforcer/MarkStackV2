{
  "name": "markstack",
  "version": "1.1.4",
  "description": "Static site generator for markdown-based knowledge bases",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "serve": "npx serve dist",
    "editor": "node editor-server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "editor:create-admin": "node scripts/create-admin.js",
    "editor:reset-admin": "node scripts/reset-admin.js"
  },
  "keywords": [
    "markdown",
    "static-site",
    "knowledge-base",
    "documentation"
  ],
  "author": "KineticEnforcer",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.3.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
